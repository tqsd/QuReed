{% if custom %}
import custom
{% endif %}


class {{ class_name }}(GenericDevice):
    ports = {
        {% for label, signal in input_ports.items() %}
        "{{ label }}": Port(
            label="{{ label }}",
            direction="input",
            signal=None,
            signal_type={{ signal }},
            device=None),
        {% endfor %}
        {% for label, signal in output_ports.items() %}
        "{{ label }}": Port(
            label="{{ label }}",
            direction="output",  # Changed from "input" to "output" for clarity
            signal=None,
            signal_type={{ signal }},
            device=None),
        {% endfor %}
    }

    properties = {
	{% for label, property in properties.items() %}
	"{{ label }}": {
	    "type": "{{ property['type'] }}",
	}{% if not loop.last %},{% endif %}
	{% endfor %}
    }
    
{% if "custom/icons/" in gui_icon %}
    gui_icon = "{{ gui_icon }}"
{% else %}
    gui_icon = {{ gui_icon }}
{% endif %}
    gui_name = "{{ name }}"
    gui_tags = [
    {% for tag in tags -%}
       "{{ tag }}",
    {% endfor %}
    ]
    gui_documentation = None
    
    power_peak = 0
    power_average = 0
    
    reference = None
      
